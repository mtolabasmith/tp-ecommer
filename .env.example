# ============================================================
#  Variables de entorno — copiá este archivo a .env.local
#  y completá con tus credenciales reales.
# ============================================================

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). Cualquiera de las dos sirve.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# Clave service_role: SOLO servidor. Nunca la expongas ni la pongas en NEXT_PUBLIC_*.
# Se usa para el CRUD del admin, crear órdenes y el webhook de pagos.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Admin ---
# Emails (separados por coma) que pueden entrar al panel /admin.
# Si se deja vacío, cualquier usuario autenticado es admin (modo demo).
ADMIN_EMAILS=tu@email.com

# --- Mercado Pago (https://www.mercadopago.com.ar/developers) ---
# Access Token de PRUEBA (empieza con TEST-...). Si no se setea,
# el checkout funciona en "modo demo" (confirma la orden sin pago real).
MP_ACCESS_TOKEN=TEST-xxxxxxxx
